{
  "extends": "@ogun/tsconfig/nextjs.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "declaration": false,
    "declarationMap": false,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
