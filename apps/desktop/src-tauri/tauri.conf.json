{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Öğün",
  "version": "0.1.0",
  "identifier": "app.ogun.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/app-server"],
    "resources": {
      "resources/web-server": "resources/web-server"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ogun"]
      }
    }
  }
}
