{
  "identifier": "default",
  "description": "Öğün masaüstü kabuğu — ana pencere için varsayılan izinler (GitHub issue #51, #52, #53).",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*", "https://ogun-web.vercel.app/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-store-session-token",
    "allow-load-session-token",
    "allow-clear-session-token",
    "allow-list-offline-profiles",
    "allow-upsert-offline-profile",
    "allow-remove-active-offline-profile",
    "allow-configure-offline-pin",
    "allow-unlock-offline-profile",
    "allow-lock-offline-profile",
    "allow-get-unlocked-offline-workspace",
    "allow-save-offline-workspace",
    "allow-save-offline-plan-draft",
    "allow-queue-offline-mutation",
    "allow-load-pending-offline-mutations",
    "allow-acknowledge-offline-mutations",
    "allow-save-offline-food-catalog",
    "allow-search-offline-food-catalog",
    "allow-get-offline-food-entries",
    "allow-desktop-network-available",
    "allow-show-offline-workspace",
    "allow-desktop-db-info",
    "allow-initialize-local-scope",
    "allow-replace-local-entities",
    "allow-list-local-entities",
    "allow-notify-frontend-ready",
    "allow-show-native-notification",
    "allow-control-main-window",
    "allow-focus-main-window-command",
    "allow-get-minimize-to-tray-setting",
    "allow-set-minimize-to-tray-setting",
    "allow-update-tray-today-appointments-summary",
    "allow-is-autostart-launch",
    "allow-complete-startup-launch",
    "opener:default",
    "deep-link:default",
    "notification:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
