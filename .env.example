# Ortam türü — local | staging | production. GitHub issue #46 / Prompt 8.2,
# GÖREV 1. apps/web/src/env.ts BU değere göre hangi değişkenlerin zorunlu
# olduğuna karar verir (ör. RESEND_* local'de opsiyonel, staging/production'da
# ZORUNLU). Boş bırakılırsa NODE_ENV'e göre türetilir (production build ise
# "production", aksi halde "local") — bkz. env.ts resolveAppEnvironment.
# Vercel/Docker fark etmeksizin AYNI şekilde okunur, platforma özel değil.
APP_ENV="local"

# Ana veritabanı bağlantısı. Yerelde docker-compose.yml'deki Postgres,
# üretimde Neon (Frankfurt bölgesi) — bkz. docs/deployment.md "Neon kurulumu".
# Neon'da PgBouncer havuzlu (pooler) uç noktayı (host adında "-pooler" geçer)
# kullanmak önerilir; "?sslmode=require" Neon panelinden kopyalanan dizede
# zaten vardır.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ogun"
# Opsiyonel — postgres.js istemci havuzundaki azami bağlantı sayısı. Boşsa
# postgres.js varsayılanı (10) kullanılır. Neon pooler'ı arkasında birden
# fazla web instance'ı çalıştırılıyorsa (yatay ölçekleme) PgBouncer'ın kendi
# limitini aşmamak için instance başına düşürülmesi önerilir (ör. "5").
DATABASE_POOL_MAX=""

# Better Auth
# openssl rand -base64 32 ile üretilebilir.
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials üzerinden alınır.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dosya depolama — S3 uyumlu (yerel: docker-compose.yml'deki MinIO, üretim:
# Cloudflare R2 veya S3). GitHub issue #19 / Prompt 4.3, GÖREV 3.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_FORCE_PATH_STYLE="true"
S3_BUCKET="ogun-documents"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# E-posta gönderimi (plan paylaşım linki, PDF ekli) — Resend.
# GitHub issue #36 / Prompt 6.2, GÖREV 3. https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Öğün <bildirim@sizin-alan-adiniz.com>"

# Hata takibi — Sentry (EU bölgesi). GitHub issue #45 / Prompt 8.1, GÖREV 1.
# BOŞ BIRAKILIRSA Sentry HİÇ init edilmez (bkz. apps/web/src/lib/monitoring/
# sentry.ts isSentryEnabled) — uygulama Sentry olmadan normal çalışır, bu
# değişkenler zorunlu DEĞİL. Sentry projesi oluşturulurken "Data Storage
# Location: EU" seçilmeli — DSN'in host kısmı (ör. ".de.sentry.io") o zaman
# otomatik AB bölgesini gösterir, ayrı bir kod değişikliği gerekmez.
# Sunucu tarafı (server/edge component'ler, API route'lar, server action'lar):
SENTRY_DSN=""
# İstemci tarafı (tarayıcıda çalışan React kodu) — SUNUCU DSN'İNDEN AYRI
# değişken çünkü NEXT_PUBLIC_* önekiyle build'e GÖMÜLÜR (istemciye görünür).
# Aynı Sentry projesinin DSN'i olabilir, gizli bilgi TAŞIMAZ (DSN zaten
# public bir "nereye event gönderileceği" adresidir).
NEXT_PUBLIC_SENTRY_DSN=""
# development | staging | production — boşsa NODE_ENV kullanılır.
SENTRY_ENVIRONMENT=""
# Sadece BUILD zamanında, kaynak haritası (source map) yükleme için gerekir
# (çalışma zamanında KULLANILMAZ). https://sentry.io/settings/auth-tokens/
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Yapılandırılmış sunucu loglama (pino). GitHub issue #45 / Prompt 8.1,
# GÖREV 1. trace|debug|info|warn|error|fatal — boşsa "info".
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Aşağıdaki değişkenler uygulama KODU tarafından OKUNMAZ — sadece
# docker-compose.prod.yml'in postgres/minio servislerini yapılandırmak için
# kullanılır (bkz. o dosya ve docs/deployment.md "Self-hosted: Docker + VPS").
# Vercel+Neon yolunda GEREKSİZ, self-hosted Docker dağıtımında ZORUNLU.
# GitHub issue #46 / Prompt 8.2, GÖREV 3.
# ---------------------------------------------------------------------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="ogun"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="change-me-in-production"

# Günlük yedekleme script'i (scripts/backup-db.sh) yedek dosyalarının
# yazılacağı yerel dizin. Boşsa "./backups" kullanılır. GitHub issue #46 /
# Prompt 8.2, GÖREV 4 — bkz. docs/runbook.md.
BACKUP_DIR=""
# Kaç günden eski yerel yedek dosyasının otomatik silineceği. Boşsa "14".
BACKUP_RETENTION_DAYS=""

# GitHub issue #47 / Prompt 8.3, GÖREV 4 — /panel/pilot (pilot ölçüm paneli)
# erişimine izin verilen e-posta adresleri, virgülle ayrılmış. Boşsa (veya
# ortam değişkeni yoksa) sayfa KİMSEYE görünmez (404 döner) — bkz.
# app/(app)/panel/pilot/page.tsx dosya başı notu.
PILOT_METRICS_ACCESS_EMAILS=""

# GitHub issue #60 / Faz 10, Prompt 10.2 — pazarlama (landing) sayfası.
# Sitenin herkese açık kök adresi. canonical bağlantısı, sitemap.xml ve
# OpenGraph görselinin mutlak URL'leri buradan türetilir (bkz.
# apps/web/src/lib/site-url.ts). Boşsa http://localhost:3000 varsayılır —
# uygulama yine çalışır, yalnızca bu üç metadata yerel adresi gösterir.
# Üretimde doldurulması GÜÇLÜ ÖNERİ (ör. "https://ogun.app").
NEXT_PUBLIC_SITE_URL=""
# Landing sayfasındaki "Pilot için başvur" formunun talebi gönderdiği VE
# sayfada doğrudan yazılabilir adres olarak gösterdiği e-posta. Boşken form
# AÇIK bir hata döndürür (talebi sessizce kaybetmez) ve sayfada sahte bir
# adres BASILMAZ. Gönderim RESEND_API_KEY / RESEND_FROM_EMAIL üzerinden
# yapılır — o ikisi boşsa form da çalışmaz.
NEXT_PUBLIC_PILOT_CONTACT_EMAIL=""
