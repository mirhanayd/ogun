DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ogun"

# Better Auth
# openssl rand -base64 32 ile üretilebilir.
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials üzerinden alınır.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dosya depolama — S3 uyumlu (yerel: docker-compose.yml'deki MinIO, üretim:
# Cloudflare R2 veya S3). GitHub issue #19 / Prompt 4.3, GÖREV 3.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_FORCE_PATH_STYLE="true"
S3_BUCKET="ogun-documents"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# E-posta gönderimi (plan paylaşım linki, PDF ekli) — Resend.
# GitHub issue #36 / Prompt 6.2, GÖREV 3. https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Öğün <bildirim@sizin-alan-adiniz.com>"
