{
  "name": "@ogun/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts",
    "./schema": "./src/schema/index.ts",
    "./support": "./src/support-domain.ts",
    "./clinical-reviewer-invitation": "./src/clinical-reviewer-invitation.ts",
    "./measurement-device-import": "./src/domain/measurement-device-import.ts",
    "./operations": "./src/operational-policy.ts",
    "./queries": "./src/queries/index.ts",
    "./database-target": "./src/database-target.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:check": "tsx src/scripts/migrate.ts --check",
    "db:compatibility:check": "tsx src/scripts/check-migration-compatibility.ts",
    "db:verify:phase7-incident": "tsx src/scripts/verify-phase7-incident.ts",
    "db:push": "tsx src/scripts/push.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed/index.ts",
    "db:seed:demo": "tsx src/seed/demo.ts",
    "db:translate-foods": "tsx src/seed/translate-foods.ts",
    "platform-admin:grant": "tsx src/scripts/platform-admin.ts grant",
    "platform-admin:revoke": "tsx src/scripts/platform-admin.ts revoke",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ogun/nutrition-core": "workspace:*",
    "@ogun/subscription-core": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "better-auth": "^1.6.31",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ogun/tsconfig": "workspace:*",
    "@types/node": "^20",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.0.4"
  }
}
